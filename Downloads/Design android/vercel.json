{
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/verify",
      "dest": "/verify.html"
    },
    {
      "src": "/verify/(.*)",
      "dest": "/verify.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
